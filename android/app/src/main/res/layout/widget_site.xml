<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/ic_launcher" android:contentDescription="ølrating" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="@string/w_h_site" android:textColor="#FF7A3D" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/visits" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFC85A" android:textSize="32sp" android:textStyle="bold" android:maxLines="1" android:text="–" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#B8C7DE" android:textSize="11sp" android:text="@string/w_visits_total" />
        <TextView android:id="@+id/today" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#8FB6E3" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/beers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:text="–" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B8C7DE" android:textSize="11sp" android:text="@string/w_beers" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/reviews" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:text="–" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B8C7DE" android:textSize="11sp" android:maxLines="1" android:text="@string/w_reviews" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tasters" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:text="–" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B8C7DE" android:textSize="11sp" android:text="@string/w_tasters" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
