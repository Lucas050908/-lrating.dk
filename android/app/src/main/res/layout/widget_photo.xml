<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="UGENS ØL" android:textColor="#FF7A3D" android:textSize="11sp" android:textStyle="bold" />
    <ImageView android:id="@+id/photo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:scaleType="fitCenter" android:src="@mipmap/ic_launcher" android:contentDescription="Billede af ugens øl" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="6dp" android:gravity="center_vertical">
        <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="ølrating.dk" />
        <TextView android:id="@+id/score" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFC85A" android:textSize="20sp" android:textStyle="bold" android:layout_marginStart="8dp" />
    </LinearLayout>
    <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B8C7DE" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
